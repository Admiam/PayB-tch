.env
.env.*
!.env.example
*.pfx
*.p8
*.p12
appsettings.Local.json

# ── Runtime / local data ──────────────────────────────────────────────
# Filesystem blob store target (Blob:LocalRoot) and local uploads.
backend/.blobs/
backend/**/wwwroot/uploads/

