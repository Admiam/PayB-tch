# Deployment secrets. Copy to .env and fill in — .env is gitignored.
#
#   cp .env.example .env
#   docker compose run --rm migrate     # first deploy only
#   docker compose up -d --build

# The hostname Caddy obtains a certificate for. Use ":80" to test locally,
# since Let's Encrypt cannot validate localhost.
SITE_ADDRESS=pay.holu.be
PUBLIC_BASE_URL=https://pay.holu.be

# Database. Any long random string; only the containers ever see it.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Signs access tokens. Changing it signs everyone out.
#   openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt
# Paste the whole PEM including the BEGIN/END lines, as a single line with \n.
JWT_SIGNING_KEY_PEM=
JWT_ISSUER=https://pay.holu.be

# Peppers the stored login-code hashes.
#   openssl rand -base64 32
OTP_PEPPER=

# Login codes are emailed, so without a working relay nobody can sign in.
# Any SMTP provider works — this is not tied to one vendor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@holu.be
SMTP_FROM_NAME=Paybitch

# Only needed when a browser on a *different* origin calls this API — e.g. a
# local dev server. Leave empty in production, where Caddy serves both from one
# origin and CORS never applies.
WEB_ORIGIN=
